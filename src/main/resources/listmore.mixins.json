{
  "required": true,
  "package": "com.listmore.mixin",
  "compatibilityLevel": "JAVA_${java_version}",
  "client": [
    "MinecraftMixin",
    "MultiPlayerGameModeMixin",
    "BlockItemMixin",
    "ClientPacketListenerMixin",
    "EntityMixin",
    "EntityRenderDispatcherMixin",
    "AbstractContainerScreenMixin",
    "accessor.GuiListBaseAccessor"${legacy_gui_graphics_accessors},
    "accessor.EntityBoundSoundInstanceAccessor",
    "litematica.GuiSchematicBrowserBaseMixin"
  ],
  "mixins": [
    "WidgetConfigOptionMixin",
    "WidgetListConfigOptionsMixin",
    "WidgetStringListEditEntryMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  },
  "mixinextras": {
    "minVersion": "0.5.0"
  }
}
